{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portos.example.invalid/schemas/v2/flagshipTracks.schema.json",
  "title": "PORTOS V2 scenario flagshipTracks",
  "description": "Versioned V2 scenario extension (simulated). Additive to the base fixture; never live data.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "forecast": {
        "type": "object",
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 359
                },
                {
                  "enum": [
                    "underway",
                    "at_anchor",
                    "moored",
                    "not_under_command",
                    "unknown"
                  ]
                }
              ],
              "items": false,
              "minItems": 5
            }
          },
          "startUtc": {
            "type": "string",
            "pattern": "Z$"
          }
        },
        "required": [
          "samples",
          "startUtc"
        ],
        "additionalProperties": false
      },
      "history": {
        "type": "object",
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 359
                },
                {
                  "enum": [
                    "underway",
                    "at_anchor",
                    "moored",
                    "not_under_command",
                    "unknown"
                  ]
                }
              ],
              "items": false,
              "minItems": 5
            }
          },
          "startUtc": {
            "type": "string",
            "pattern": "Z$"
          }
        },
        "required": [
          "samples",
          "startUtc"
        ],
        "additionalProperties": false
      },
      "intervalMinutes": {
        "type": "integer"
      },
      "routeId": {
        "type": "string"
      },
      "sourceType": {
        "type": "string"
      },
      "vesselId": {
        "type": "string"
      },
      "voyageId": {
        "type": "string"
      }
    },
    "required": [
      "forecast",
      "history",
      "intervalMinutes",
      "routeId",
      "sourceType",
      "vesselId",
      "voyageId"
    ],
    "additionalProperties": false
  }
}
