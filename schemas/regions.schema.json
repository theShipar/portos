{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portos.example.invalid/schemas/regions.schema.json",
  "title": "PORTOS synthetic regions collection",
  "description": "Synthetic scenario fixtures. Not live AIS or navigational data.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "bounds": {
        "type": "object",
        "properties": {
          "east": {
            "type": "integer"
          },
          "north": {
            "type": "integer"
          },
          "south": {
            "type": "integer"
          },
          "west": {
            "type": "integer"
          }
        },
        "required": [
          "east",
          "north",
          "south",
          "west"
        ],
        "additionalProperties": false
      },
      "cameraPreset": {
        "type": "object",
        "properties": {
          "distance": {
            "type": "integer"
          },
          "headingDeg": {
            "type": "integer"
          },
          "pitchDeg": {
            "type": "integer"
          }
        },
        "required": [
          "distance",
          "headingDeg",
          "pitchDeg"
        ],
        "additionalProperties": false
      },
      "center": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "integer"
          },
          "lon": {
            "type": "integer"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      },
      "countryIso3": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "kind": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "portIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "regionId": {
        "type": "string"
      },
      "sourceType": {
        "type": "string"
      }
    },
    "required": [
      "bounds",
      "cameraPreset",
      "center",
      "countryIso3",
      "kind",
      "name",
      "portIds",
      "regionId",
      "sourceType"
    ],
    "additionalProperties": false
  }
}
