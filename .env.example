# 2D basemap (decision D-011). Copy to .env.local to override. Set either URL to "none" to disable tiles.
# Full MapLibre style URL, used as-is (takes precedence over the PORTOS style below).
VITE_PORT_BASEMAP_STYLE_URL=
# OpenMapTiles-schema TileJSON for the built-in PORTOS dark style (default: OpenFreeMap, free, no key).
VITE_PORT_BASEMAP_TILES_URL=https://tiles.openfreemap.org/planet
VITE_PORT_BASEMAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
